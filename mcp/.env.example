# Copy to mcp/.env for local use (gitignored). Set the same names in Deno Deploy (project mutande-mcp).
# Full Auth0 + connector setup: README.md and docs/AUTH0.md §8.

# Public base URL of this MCP server (no trailing slash).
MCP_PUBLIC_URL=https://mcp.mutande.online
# Local override example:
# MCP_PUBLIC_URL=http://127.0.0.1:3849

# Auth0 (same tenant/custom domain as hub + Mac + web)
AUTH0_DOMAIN=auth.mutande.online
# Hub API audience (Mac/web first-party tokens). ChatGPT DCR uses the MCP
# resource as aud — defaults to MCP_PUBLIC_URL when unset (hub must match).
AUTH0_AUDIENCE=https://hub.mutande.app
AUTH0_MCP_AUDIENCE=https://mcp.mutande.online
# Optional comma-separated extra iss hosts (tenant while custom domain rolls out).
# AUTH0_ISSUER_ALIASES=chevrondigital.auth0.com
# (auth.mutande.online auto-aliases chevrondigital.auth0.com)

# Hub API (web agent bind + future inbox tools)
MUTANDE_HUB_URL=https://hub.mutande.online
# Local: MUTANDE_HUB_URL=http://127.0.0.1:8000

# Default web agent slug when the host does not pass one (ChatGPT web → chatgpt).
MCP_DEFAULT_AGENT_SLUG=chatgpt

# Listen port (local only; Deno Deploy ignores)
PORT=3849

# GlitchTip (Sentry-compatible) — mcp project 26806 is the built-in default.
# Override or set empty to disable: MUTANDE_SENTRY_DSN=  or SENTRY_DSN=
# MUTANDE_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_SMOKE=1