# Copy to hub/.env for local use (gitignored). Set the same names in Deno Deploy.
# Full setup: docs/AUTH0.md

# Auth0 (required for the Auth0-first path; required on Deno Deploy)
# Domain = tenant host only (no https://). Audience = Auth0 API Identifier.
AUTH0_DOMAIN=auth.mutande.online
AUTH0_AUDIENCE=https://hub.mutande.app
# Optional: public URL stamped on transport=mcp agent rows (default https://mcp.mutande.online)
# MCP_ENDPOINT=https://mcp.mutande.online
# L2 app_envelope at-rest key: base64 of 32 random bytes (AES-256-GCM).
# Protects against storage compromise, NOT the hub operator (§4.6).
# When unset, payloads are plaintext-at-rest (local/dev interim — set in prod).
# APP_ENVELOPE_KEY=
# Optional comma-separated extra iss hosts (tenant while custom domain rolls out).
# AUTH0_ISSUER_ALIASES=chevrondigital.auth0.com
# Optional: Auth0 role names/ids allowed for product-owner ops (feedback/waitlist).
# MUTANDE_PLATFORM_ADMIN_ROLES=SuperAdmin,rol_jsa0BZq7uzz2K4RG

# Cloudflare R2 (required on Deno Deploy for real blob URLs)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mutande-blobs

# Optional: mock URL base when R2 is unset (local only)
# R2_PUBLIC_BASE=https://blobs.mutande.app

# GlitchTip (Sentry-compatible) — hub project 26611 is the built-in default.
# Override or set empty to disable: MUTANDE_SENTRY_DSN=  or SENTRY_DSN=
# MUTANDE_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_SMOKE=1

# Public installers (scripts/upload-downloads-r2.sh + Windows GHA publish-r2).
# Prefer a token scoped to mutande-releases — blobs keys get AccessDenied there.
# R2_DOWNLOADS_ACCESS_KEY_ID=
# R2_DOWNLOADS_SECRET_ACCESS_KEY=
# R2_DOWNLOADS_BUCKET=mutande-releases
# R2_DOWNLOADS_PUBLIC_BASE=https://downloads.mutande.online
