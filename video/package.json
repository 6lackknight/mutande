{
  "name": "video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.502",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.502",
    "@remotion/tailwind-v4": "4.0.502",
    "tailwindcss": "4.0.0"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.502",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render": "remotion render LandingIntro out/landing-intro.mp4 --codec=h264 --muted",
    "render:webm": "remotion render LandingIntro out/landing-intro.webm --codec=vp9 --muted",
    "optimize": "npm run optimize:mp4 && npm run optimize:webm",
    "optimize:mp4": "ffmpeg -y -i out/landing-intro.mp4 -an -c:v libx264 -profile:v main -pix_fmt yuv420p -r 30 -crf 22 -movflags +faststart ../web/public/brand/landing-intro.mp4",
    "optimize:webm": "ffmpeg -y -i out/landing-intro.mp4 -an -c:v libvpx-vp9 -b:v 0 -crf 32 -r 30 -row-mt 1 ../web/public/brand/landing-intro.webm",
    "poster": "remotion still LandingIntro out/landing-intro-poster.png --frame=1580",
    "ship": "npm run render && npm run optimize && npm run poster && cp out/landing-intro-poster.png ../web/public/brand/"
  },
  "sideEffects": [
    "*.css"
  ]
}