# Full setup: docs/AUTH0.md
# Copy to web/.env.local for local use (gitignored). Same names on Vercel.

# App
# Local:
APP_BASE_URL=http://localhost:3000
# Production (Vercel): https://mutande.online  — until mutande.ai

# Auth0 Regular Web Application (not the Native Mac app)
# Dashboard → Applications → Create → Regular Web Application
# Allowed Callback URLs: http://localhost:3000/auth/callback + https://mutande.online/auth/callback
# Allowed Logout URLs:   http://localhost:3000 + https://mutande.online (+ /auth/logout)
# Allowed Web Origins:   http://localhost:3000 + https://mutande.online

AUTH0_DOMAIN=auth.mutande.online
# Mutande Web (Regular Web App) — fill CLIENT_ID/SECRET from dashboard or web/.env.local
AUTH0_CLIENT_ID=OIXTFBp5IKFHaykZ4x91DlDy1LnnLEti
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=

# Must match hub AUTH0_AUDIENCE (Auth0 API identifier)
AUTH0_AUDIENCE=https://hub.mutande.app

# Hub API (Deno Deploy)
MUTANDE_HUB_URL=https://mutande.6lackknight.deno.net

# Public installer CDN — mutande-releases R2 bucket (r2.dev). No trailing slash.
# Upload: ./scripts/upload-downloads-r2.sh
# NEXT_PUBLIC_DOWNLOADS_BASE=https://downloads.mutande.online
# NEXT_PUBLIC_MAC_DMG_VERSION=1.0.5
# NEXT_PUBLIC_MAC_INTEL_PUBLISHED=1
# NEXT_PUBLIC_WIN_ZIP_PUBLISHED=1
# Optional per-file overrides:
# NEXT_PUBLIC_MAC_DMG_URL_ARM64=
# NEXT_PUBLIC_MAC_DMG_URL_INTEL=
# NEXT_PUBLIC_WIN_ZIP_URL=

# Optional — invite emails via Plunk (https://useplunk.com)
# When unset, invites still create; copy link from admin UI
PLUNK_API_KEY=

# Optional — Mixpanel project token (client-safe). When unset, analytics is a no-op.
# Never send mail content / email / handle. Autocapture + session replay enabled in code.
# NEXT_PUBLIC_MIXPANEL_TOKEN=
