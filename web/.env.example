# Full setup: docs/AUTH0.md
# Copy to web/.env.local for local use (gitignored). Same names on Vercel.

# App
# Local:
APP_BASE_URL=http://localhost:3000
# Production (Vercel): https://mutande.vercel.app  — until mutande.ai

# Auth0 Regular Web Application (not the Native Mac app)
# Dashboard → Applications → Create → Regular Web Application
# Allowed Callback URLs: http://localhost:3000/auth/callback + https://mutande.vercel.app/auth/callback
# Allowed Logout URLs:   http://localhost:3000 + https://mutande.vercel.app (+ /auth/logout)
# Allowed Web Origins:   http://localhost:3000 + https://mutande.vercel.app
AUTH0_DOMAIN=chevrondigital.auth0.com
# Mutande Web (Regular Web App) — fill CLIENT_ID/SECRET from dashboard or web/.env.local
AUTH0_CLIENT_ID=OIXTFBp5IKFHaykZ4x91DlDy1LnnLEti
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=

# Must match hub AUTH0_AUDIENCE (Auth0 API identifier)
AUTH0_AUDIENCE=https://hub.mutande.app

# Hub API (Deno Deploy)
MUTANDE_HUB_URL=https://mutande.6lackknight.deno.net

# Optional — Mac DMG (defaults to /downloads/mutande-latest.dmg on this site)
# NEXT_PUBLIC_MAC_DMG_URL=https://pub-….r2.dev/macos/mutande-latest.dmg
# NEXT_PUBLIC_MAC_DMG_VERSION=1.0.0

# Optional — invite emails via Plunk (https://useplunk.com)
# When unset, invites still create; copy link from admin UI
PLUNK_API_KEY=
