        { "name": "auth0_audience", "type": "string", "required": false },
        { "name": "access_token", "type": "string", "required": false },
        { "name": "refresh_token", "type": "string", "required": false },
        { "name": "open_browser", "type": "bool", "required": false }
      ],
      "notes": "Auth0 PKCE/loopback login; persists tokens; registers device."
    },
    {
      "name": "auth_logout",
      "kind": "core",
      "params": [],
      "notes": "Clears tokens, keeps hub_url."
    },
