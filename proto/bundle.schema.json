{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutande.app/schemas/bundle/v1",
  "title": "MutandeBundle",
  "description": "Plaintext bundle shape before client-side E2E encryption.",
  "type": "object",
  "properties": {
    "subject": { "type": "string" },
    "context": { "type": "string" },
    "questions": {
      "type": "array",
      "items": { "$ref": "human-decision.schema.json" }
    },
    "resource_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "mime"],
        "properties": {
          "name": { "type": "string" },
          "mime": { "type": "string" },
          "content": {
            "type": "string",
            "description": "Inline text for small UTF-8 artifacts. Large/binary resources omit this after open and set path instead."
          },
          "path": {
            "type": "string",
            "description": "Absolute local plaintext path after open (this device's daemon cache). Prefer reading this for binary/large artifacts."
          },
          "storage": { "type": "string", "enum": ["inline", "blob"] },
          "blob_id": { "type": "string" },
          "wrapped_key": { "type": "string" },
          "sha256": { "type": "string" },
          "size": {
            "type": "integer",
            "description": "Plaintext byte length when known."
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "answer"],
        "properties": {
          "question_id": { "type": "string" },
          "answer": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" },
    "ping_kind": {
      "type": "string",
      "enum": ["health", "thread"],
      "description": "Marks a product ping: health gets daemon auto-pong; thread expects agent reply_to_thread."
    },
    "in_reply_to": {
      "type": "string",
      "format": "uuid",
      "description": "Parent message id for nested thread replies."
    }
  }
}
