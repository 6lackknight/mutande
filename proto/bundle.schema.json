{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mutande.app/schemas/bundle/v1",
  "title": "MutandeBundle",
  "description": "Plaintext bundle shape before client-side E2E encryption.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Bundle schema version. Absent = 1; this revision = 2."
    },
    "intent": {
      "type": "string",
      "enum": ["question", "answer", "handoff", "status", "fyi"],
      "description": "Message intent. Required by MCP tools; optional for legacy bundles."
    },
    "subject": { "type": "string" },
    "context": { "type": "string" },
    "questions": {
      "type": "array",
      "items": { "$ref": "human-decision.schema.json" }
    },
    "resource_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "mime"],
        "properties": {
          "name": { "type": "string" },
          "mime": { "type": "string" },
          "content": {
            "type": "string",
            "description": "Inline text for small UTF-8 artifacts. Large/binary resources omit this after open and set path instead."
          },
          "path": {
            "type": "string",
            "description": "Absolute local plaintext path after open (this device's daemon cache). Prefer reading this for binary/large artifacts."
          },
          "storage": { "type": "string", "enum": ["inline", "blob"] },
          "blob_id": { "type": "string" },
          "wrapped_key": { "type": "string" },
          "sha256": { "type": "string" },
          "size": {
            "type": "integer",
            "description": "Plaintext byte length when known."
          }
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "answer"],
        "properties": {
          "question_id": { "type": "string" },
          "answer": { "type": "string" }
        }
      }
    },
    "notes": { "type": "string" },
    "ping_kind": {
      "type": "string",
      "enum": ["health", "thread"],
      "description": "Marks a product ping: health gets daemon auto-pong; thread expects agent reply_to_thread."
    },
    "in_reply_to": {
      "type": "string",
      "format": "uuid",
      "description": "Parent message id for nested thread replies."
    },
    "next_turn": {
      "type": "array",
      "description": "Declared holders of the next turn after this message.",
      "items": { "$ref": "#/$defs/TurnEntry" }
    },
    "task": {
      "$ref": "#/$defs/Task",
      "description": "Structured work handoff (expected with intent=handoff)."
    },
    "hints": {
      "type": "array",
      "description": "Enumerated handling/presentation advice. Unknown kinds must be ignored.",
      "items": { "$ref": "#/$defs/Hint" }
    }
  },
  "$defs": {
    "TurnEntry": {
      "type": "object",
      "required": ["address", "actor"],
      "properties": {
        "address": {
          "type": "string",
          "description": "Display address expected to act (handle, handle/agent, or @slug)."
        },
        "actor": {
          "type": "string",
          "enum": ["agent", "human"]
        },
        "reason": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "question_id"],
              "properties": {
                "kind": { "const": "question" },
                "question_id": { "type": "string" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "const": "review" }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["kind"],
              "properties": {
                "kind": { "const": "handoff" }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "Task": {
      "type": "object",
      "required": ["objective"],
      "properties": {
        "objective": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "type": "string" }
        },
        "deliverables": {
          "type": "array",
          "items": { "type": "string" }
        },
        "constraints": {
          "type": "array",
          "items": { "type": "string" }
        },
        "done_when": { "type": "string" }
      },
      "additionalProperties": false
    },
    "Hint": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["render_decision", "render_canvas", "recall_context"]
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
