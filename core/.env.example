# Auth0 Native Application — Mutande Mac (client id is public; no secret)
# Custom domain (login + JWKS): auth.mutande.online
# Manage tenant: https://manage.auth0.com/dashboard/us/chevrondigital/applications/2cbPq8c2JelRxBRkvKlSHTmrM91ItUUm/settings
# Allowed Callback URLs: http://127.0.0.1:8732/callback , http://127.0.0.1:3848/auth/callback
# Grant Types: Authorization Code, Refresh Token (offline_access via API allow_offline_access)
#
# Copy to core/.env for local daemon (gitignored), OR pass Flutter dart-defines:
#   flutter run -d macos \
#     --dart-define=AUTH0_DOMAIN=auth.mutande.online \
#     --dart-define=AUTH0_NATIVE_CLIENT_ID=2cbPq8c2JelRxBRkvKlSHTmrM91ItUUm \
#     --dart-define=AUTH0_AUDIENCE=https://hub.mutande.app
AUTH0_DOMAIN=auth.mutande.online
AUTH0_NATIVE_CLIENT_ID=2cbPq8c2JelRxBRkvKlSHTmrM91ItUUm
# Must match hub AUTH0_AUDIENCE (Auth0 API identifier)
AUTH0_AUDIENCE=https://hub.mutande.app

# Hub API
MUTANDE_HUB_URL=https://mutande.6lackknight.deno.net

# Optional plumbing bypass (skip browser OAuth in tests/dev)
# MUTANDE_AUTH0_ACCESS_TOKEN=
# MUTANDE_AUTH0_REFRESH_TOKEN=
